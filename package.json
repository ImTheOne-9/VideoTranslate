{
  "name": "youtube-shorts-downloader",
  "version": "1.0.0",
  "description": "YouTube Shorts Video Downloader",
  "main": "main.js",
  "scripts": {
    "start": "node server.js",
    "dev": "node server.js",
    "electron-dev": "electron .",
    "electron-dist": "electron-builder build --win --x64",
    "build-obfuscate": "node tools/obfuscate.js --build"
  },
  "dependencies": {
    "@distube/ytdl-core": "^4.16.1",
    "@vitalets/google-translate-api": "^9.2.1",
    "adm-zip": "^0.5.17",
    "axios": "^1.18.0",
    "content-disposition": "^0.5.4",
    "express": "^4.21.0",
    "form-data": "^4.0.6",
    "mongoose": "^9.7.1",
    "multer": "^2.1.1",
    "node-machine-id": "^1.1.12",
    "srt-parser-2": "^1.2.3",
    "whisper-node": "^1.1.1"
  },
  "devDependencies": {
    "electron": "^42.4.1",
    "electron-builder": "^26.15.3",
    "javascript-obfuscator": "^5.4.3"
  },
  "build": {
    "appId": "com.videostudio.app",
    "productName": "Video Studio Tools",
    "directories": {
      "output": "dist"
    },
    "files": [
      "public/**/*",
      "lib/**/*",
      "server.js",
      "main.js",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "tools/",
        "to": "tools/",
        "filter": [
          "ffmpeg.exe",
          "yt-dlp.exe",
          "msvcp140.dll",
          "vcomp140.dll",
          "vcruntime140.dll",
          "vcruntime140_1.dll",
          "whisper_onnx.exe",
          "nllb_translate.exe",
          "omnivoice/omnivoice-cli.exe",
          "omnivoice/*.dll"
        ]
      }
    ],
    "win": {
      "target": [
        "nsis"
      ],
      "requestedExecutionLevel": "asInvoker"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "deleteAppDataOnUninstall": false
    }
  }
}
