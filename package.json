{
  "name": "video-studio-tools",
  "version": "1.0.46",
  "description": "Video Studio Tools",
  "main": "index.js",
  "scripts": {
    "start": "node server.js",
    "dev": "node server.js",
    "electron-dev": "electron .",
    "package-preflight": "node scripts/package-preflight.js",
    "electron-dist": "node obfuscate.js --build --no-update",
    "build-obfuscate": "node obfuscate.js --build",
    "pack-unpacked": "node obfuscate.js --build --dir --no-update",
    "test": "node test/run-tests.js"
  },
  "dependencies": {
    "@distube/ytdl-core": "^4.16.1",
    "@huggingface/transformers": "^3.8.1",
    "@vitalets/google-translate-api": "^9.2.1",
    "adm-zip": "^0.5.17",
    "axios": "^1.18.0",
    "bytenode": "^1.6.0",
    "content-disposition": "^0.5.4",
    "dotenv": "^17.4.2",
    "electron-updater": "^6.8.9",
    "express": "^4.21.0",
    "form-data": "^4.0.6",
    "mongoose": "^9.7.1",
    "multer": "^2.1.1",
    "node-machine-id": "^1.1.12",
    "playwright": "^1.49.1",
    "sharp": "^0.34.5",
    "srt-parser-2": "^1.2.3",
    "unzipper": "^0.12.3",
    "wavefile": "^11.0.0",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "electron": "^42.4.1",
    "electron-builder": "^26.15.3",
    "javascript-obfuscator": "^5.4.3"
  },
  "build": {
    "appId": "com.videostudio.app",
    "productName": "Video Studio Tools",
    "publish": {
      "provider": "generic",
      "url": "https://huggingface.co/datasets/dvh1910/video-studio-tools/resolve/main/"
    },
    "directories": {
      "output": "D:/BuildApp"
    },
    "asar": true,
    "asarUnpack": [
      "node_modules/onnxruntime-node/**/*",
      "node_modules/onnxruntime-common/**/*",
      "node_modules/@huggingface/transformers/**/*",
      "node_modules/sharp/**/*",
      "node_modules/@img/**/*",
      "node_modules/detect-libc/**/*",
      "node_modules/semver/**/*",
      "node_modules/wavefile/**/*"
    ],
    "files": [
      "public/**/*",
      "scripts/**/*",
      "lib/**/*.jsc",
      "controllers/**/*.jsc",
      "server.jsc",
      "main.jsc",
      "index.js",
      "silero-vad-child-runtime.js",
      "whisper-onnx-child-runtime.js",
      "logo.ico",
      "package.json",
      "changelog.json"
    ],
    "extraResources": [
      {
        "from": "tools/crawler/",
        "to": "tools/crawler/",
        "filter": [
          "app/**/*",
          "!app/**/browser_data/**/*",
          "!app/**/__pycache__/**/*",
          "!app/**/*.pyc",
          "!app/**/test/**/*",
          "!app/**/tests/**/*",
          "!app/**/test_data/**/*",
          "!app/**/docs/**/*",
          "!app/**/.git/**/*",
          "!app/**/data/**/*",
          "!app/**/media_data/**/*",
          "requirements-crawler.txt",
          "requirements-asr.txt",
          "requirements-ocr.txt",
          "README.md",
          "install-ocr-gpu.py",
          "install-whisper-gpu.py",
          "setup-runtime.ps1",
          "setup-piper-runtime.ps1",
          "runtime/**/*"
        ]
      },
      {
        "from": "tools/",
        "to": "tools/",
        "filter": [
          "ffmpeg.exe",
          "ffprobe.exe",
          "yt-dlp.exe",
          "uv.exe",
          "node/node.exe",
          "nllb_translate.exe",
          "silero-vad/silero_vad.onnx",
          "omnivoice/omnivoice-cli.exe",
          "omnivoice/omnivoice-server-*.exe",
          "omnivoice/*.dll"
        ]
      }
    ],
    "win": {
      "icon": "logo.ico",
      "target": [
        "nsis"
      ],
      "requestedExecutionLevel": "asInvoker"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "installerIcon": "logo.ico",
      "uninstallerIcon": "logo.ico",
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "deleteAppDataOnUninstall": false,
      "artifactName": "Video-Studio-Tools-Setup-${version}.${ext}"
    }
  }
}
