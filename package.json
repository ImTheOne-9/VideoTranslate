{
  "name": "youtube-shorts-downloader",
  "version": "1.0.0",
  "description": "YouTube Shorts Video Downloader",
  "main": "main.js",
  "scripts": {
    "start": "node server.js",
    "dev": "node server.js",
    "electron-dev": "electron .",
    "electron-dist": "electron-builder build --win --x64"
  },
  "dependencies": {
    "@distube/ytdl-core": "^4.16.1",
    "@vitalets/google-translate-api": "^9.2.1",
    "content-disposition": "^0.5.4",
    "express": "^4.21.0",
    "multer": "^2.1.1",
    "srt-parser-2": "^1.2.3",
    "whisper-node": "^1.1.1"
  },
  "devDependencies": {
    "electron": "^42.4.1",
    "electron-builder": "^26.15.3"
  },
  "build": {
    "appId": "com.videostudio.app",
    "productName": "Video Studio Tools",
    "directories": {
      "output": "dist"
    },
    "files": [
      "public/**/*",
      "lib/**/*",
      "server.js",
      "main.js",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "tools/",
        "to": "tools/",
        "filter": [
          "ffmpeg.exe",
          "yt-dlp.exe",
          "whisper.exe",
          "whisper_models/base.pt",
          "omnivoice/omnivoice-cli.exe",
          "omnivoice/*.dll",
          "omnivoice/models/omnivoice-q8_0.gguf"
        ]
      },
      {
        "from": "python_engine/",
        "to": "python_engine/",
        "filter": [
          "**/*"
        ]
      }
    ],
    "win": {
      "target": [
        "nsis"
      ],
      "requestedExecutionLevel": "asInvoker"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "deleteAppDataOnUninstall": false
    }
  }
}
