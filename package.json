{
  "name": "video-studio-tools",
  "version": "1.0.22",
  "description": "Video Studio Tools",
  "main": "index.js",
  "scripts": {
    "start": "node server.js",
    "dev": "node server.js",
    "electron-dev": "electron .",
    "electron-dist": "electron-builder build --win --x64",
    "build-obfuscate": "node obfuscate.js --build",
    "test": "node test/run-tests.js"
  },
  "dependencies": {
    "@distube/ytdl-core": "^4.16.1",
    "@vitalets/google-translate-api": "^9.2.1",
    "adm-zip": "^0.5.17",
    "axios": "^1.18.0",
    "bytenode": "^1.6.0",
    "content-disposition": "^0.5.4",
    "dotenv": "^17.4.2",
    "electron-updater": "^6.8.9",
    "express": "^4.21.0",
    "form-data": "^4.0.6",
    "mongoose": "^9.7.1",
    "multer": "^2.1.1",
    "node-machine-id": "^1.1.12",
    "srt-parser-2": "^1.2.3",
    "whisper-node": "^1.1.1"
  },
  "devDependencies": {
    "electron": "^42.4.1",
    "electron-builder": "^26.15.3",
    "javascript-obfuscator": "^5.4.3"
  },
  "build": {
    "appId": "com.videostudio.app",
    "productName": "Video Studio Tools",
    "publish": {
      "provider": "generic",
      "url": "https://huggingface.co/datasets/dvh1910/video-studio-tools/resolve/main/"
    },
    "directories": {
      "output": "D:/BuildApp"
    },
    "asar": true,
    "files": [
      "public/**/*",
      "lib/**/*.jsc",
      "controllers/**/*.jsc",
      "server.jsc",
      "main.jsc",
      "index.js",
      "logo.ico",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "tools/",
        "to": "tools/",
        "filter": [
          "ffmpeg.exe",
          "yt-dlp.exe",
          "nllb_translate.exe",
          "omnivoice/omnivoice-cli.exe",
          "omnivoice/*.dll"
        ]
      }
    ],
    "win": {
      "icon": "logo.ico",
      "target": [
        "nsis"
      ],
      "requestedExecutionLevel": "asInvoker"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "installerIcon": "logo.ico",
      "uninstallerIcon": "logo.ico",
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "deleteAppDataOnUninstall": false,
      "artifactName": "Video-Studio-Tools-Setup-${version}.${ext}"
    }
  }
}
