# ============================================================
# License Server - Mẫu cấu hình biến môi trường
# ============================================================
# Hướng dẫn: Copy file này thành ".env" và điền giá trị thật.
# KHÔNG BAO GIỜ commit file ".env" lên Git.
# ============================================================

# --- Server ---
PORT=4000

# --- Facebook OAuth (chỉ cấu hình trên backend/Render) ---
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=
FACEBOOK_GRAPH_API_VERSION=v25.0
FACEBOOK_OAUTH_REDIRECT_URI=https://editnhanh.com/api/facebook/oauth/callback
# Khóa AES-256, 32 byte ngẫu nhiên mã hóa base64; không dùng lại App Secret.
# Sinh trên server: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
FACEBOOK_OAUTH_ENCRYPTION_KEY=
# Tùy chọn: ID cấu hình Facebook Login for Business đang dùng.
FACEBOOK_LOGIN_CONFIG_ID=
FACEBOOK_WEBHOOK_VERIFY_TOKEN=
ADMIN_TOKEN=

# --- MongoDB ---
MONGODB_URI=mongodb://127.0.0.1:27017/license_server

# --- Ed25519 Private Key (Ký license) ---
# Sinh cặp khóa mới bằng: node -e "const c=require('crypto');const{k}=c.generateKeyPairSync('ed25519',{privateKeyEncoding:{type:'pkcs8',format:'pem'},publicKeyEncoding:{type:'spki',format:'pem'}});console.log('PRIVATE:');console.log(k.privateKey);console.log('PUBLIC:');console.log(k.publicKey)"
# PRIVATE KEY dùng để ký (chỉ giữ trên server, trong file .env)
# PUBLIC KEY nhúng vào client (lib/license-manager.js)
LICENSE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----
MC4CAQAwBQYDK2VwBCIEINCSkH2ERf0+fEmOBZAFIHPJlihYwsLNf2g4o+QZxmdw
-----END PRIVATE KEY-----"

# --- Email (Resend hoặc SMTP) ---
RESEND_API_KEY=
RESEND_FROM=
EMAIL_HOST=
EMAIL_PORT=
EMAIL_USER=
EMAIL_PASS=

# --- Meta Ads Pixel & CAPI ---
META_PIXEL_ID=1048557318333738
META_CAPI_ACCESS_TOKEN=
META_GRAPH_API_VERSION=v26.0
META_CAPI_TIMEOUT_MS=8000
META_CAPI_MAX_ATTEMPTS=3
# Chỉ dùng khi kiểm thử trong Meta Events Manager, để trống khi production
META_TEST_EVENT_CODE=
