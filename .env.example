# ============================================================
# Video Studio Tools - Mẫu cấu hình biến môi trường
# ============================================================
# Hướng dẫn: Copy file này thành ".env" và điền giá trị thật.
# KHÔNG BAO GIỜ commit file ".env" lên Git (đã có trong .gitignore).
# ============================================================

# --- Vbee TTS API (dùng để tạo giọng mẫu) ---
# Lấy token từ dashboard Vbee của bạn
VBEE_APP_ID=470eb36b-eca1-4d22-96b6-c88c997b5bea
VBEE_TOKEN=

# --- Khóa HMAC cục bộ ký license file ---
# Sinh ngẫu nhiên bằng lệnh: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
APP_LOCAL_SECRET=v1d30_stud10_l0c4l_hvs_k3y_s3cr3t_2026

# --- URL máy chủ bản quyền (mặc định cloud) ---
LICENSE_SERVER_URL=https://video-studio-license-server.onrender.com
# OAuth thực hiện trên backend; KHÔNG đặt App Secret trong ứng dụng desktop.
# Để trống để dùng LICENSE_SERVER_URL.
FACEBOOK_OAUTH_BACKEND_URL=
FACEBOOK_GRAPH_API_VERSION=v25.0
# Ngưỡng kiểm tra cục bộ, không phải tuyên bố giới hạn chung của Facebook.
# Chỉ tăng ngưỡng Reel/Story sau khi xác minh API của Page đang dùng.
FACEBOOK_MAX_VIDEO_BYTES=4294967296
# 0 = no local Reel duration cap; Meta API still decides whether the video is accepted.
FACEBOOK_REEL_MAX_SECONDS=0
FACEBOOK_STORY_MAX_SECONDS=60
# Số lần kiểm tra trạng thái; hết lượt sẽ chờ người dùng bấm Kiểm tra lại.
FACEBOOK_STATUS_POLL_MS=10000
FACEBOOK_STATUS_POLL_ATTEMPTS=60
