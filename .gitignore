# Dependencies
node_modules/
.worktrees/

# Python embedded environment
python_engine/
temp_env/

# Binaries, models, third-party tools and dependencies
tools/*

# First-party crawler/RapidOCR sources required by packaged builds. Keep large
# binaries, browser profiles, downloaded media and third-party crawler data ignored.
!tools/crawler/
tools/crawler/*
!tools/crawler/requirements-crawler.txt
!tools/crawler/setup-runtime.ps1
!tools/crawler/install-ocr-gpu.py
!tools/crawler/app/
tools/crawler/app/*
!tools/crawler/app/piper_tts_bridge.py
!tools/crawler/app/tts_chuan_hoa.py
!tools/crawler/app/audio_stretch_bridge.py
!tools/crawler/app/viral_ocr/
tools/crawler/app/viral_ocr/*
!tools/crawler/app/viral_ocr/*.py
!tools/crawler/app/viral_ocr/zhcdict.json
!tools/crawler/app/MediaCrawler/
tools/crawler/app/MediaCrawler/*
!tools/crawler/app/MediaCrawler/pyproject.toml
!tools/crawler/app/MediaCrawler/uv.lock

# Local media assets and renders (data local, KHÔNG commit)
downloads/
uploads/
renders/

# Saved projects (data local)
projects/

# Models (data local, tải sau)
models/

# Local app data directories (tạo khi chạy app packaged)
VideoStudio/
VideoStudioData/

# OS files
.DS_Store
Thumbs.db

# Build output
dist/
.tmp-mdx-cuda/
.tmp-ffmpeg-rollback/
release/mdx-onnx-cuda/*.zip

# Logs
*.log

# Local databases and secrets
.env
.env.local
license-server/.env
license-server/database.json
license.json
*.jsc

temp/


cookies/

render-jobs
